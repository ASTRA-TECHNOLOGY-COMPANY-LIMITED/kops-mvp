# KOPS local settings: copy to .env (gitignored) and fill in. Read by docker compose (env_file) and local runs.
# Never commit .env; this example holds variable names only.

# Synthetic demo data on the dashboard: 1 = on (labelled "Giả định"), 0 = real data only
KOPS_SIM=1
# Freeze "today" for reproducible checks (YYYY-MM-DD); empty = real date (Asia/Ho_Chi_Minh in Docker)
KOPS_TODAY=
# AI email extraction (KLMAS consent P2, 23/10/2026; Claude API only, results stay PENDING_REVIEW).
# Keep 0 until ANTHROPIC_API_KEY is set.
KOPS_EMAIL_LLM=0
# Claude model for email extraction (KOPS_LLM_MODEL is accepted as an alias)
KOPS_EMAIL_LLM_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=

# Optional
# KOPS_KLMAS_DOMAINS=klmasvn.com        # comma list of KLMAS mail domains
# KOPS_PARTY_FILE=dw/party_map.local.txt  # sender domain -> party type (gitignored)
# KOPS_MAX_PARSE_MB=30                   # larger report files are quarantined as TOO_LARGE
# KOPS_WORKERS=8                         # parallel parse workers
# KOPS_IMAP_PASSWORD=                    # only for `kops_dw fetch-imap` (read-only)

# Web app: first admin (make up / serve append a random password here when missing; change it at first login)
KOPS_ADMIN_USER=admin
KOPS_ADMIN_PASSWORD=
